// ---- BRAVE (hand-written: Blink declares none of these) ----------------------------------------
//
// Every line below is a member the shipped bundle's capture records that neither the vendored webref IDL
// nor the Blink IDL declares; each says where it really comes from. tools/sync/overlay_mine.py keeps
// this section verbatim when it regenerates the Blink half above.

// `navigator.brave` is Brave's own object (`isBrave()` answers a Promise<boolean>); the values bundle
// serves its shape (brave-151-linux-20260907T1006 values.json), no IDL anywhere declares it.
partial interface Navigator {
    [SameObject] readonly attribute object brave;  // brave: navigator.brave (both realms)
};
partial interface WorkerNavigator {
    [SameObject] readonly attribute object brave;  // brave: navigator.brave in a worker
};

// CSSPositionTryDescriptors: Chromium exposes each descriptor under BOTH its camelCase name (webref
// declares those) and its dashed CSS name (generated by Blink's css_properties build step, not written
// in any .idl). The dashed spellings are not WebIDL identifiers; this file's parser accepts them so
// that the captured members have a declared home with the same type as their camelCase twins.
partial interface CSSPositionTryDescriptors {
    [CEReactions] attribute CSSOMString margin-top;  // chromium: css_properties (dashed alias of marginTop)
    [CEReactions] attribute CSSOMString margin-right;
    [CEReactions] attribute CSSOMString margin-bottom;
    [CEReactions] attribute CSSOMString margin-left;
    [CEReactions] attribute CSSOMString margin-block;
    [CEReactions] attribute CSSOMString margin-block-start;
    [CEReactions] attribute CSSOMString margin-block-end;
    [CEReactions] attribute CSSOMString margin-inline;
    [CEReactions] attribute CSSOMString margin-inline-start;
    [CEReactions] attribute CSSOMString margin-inline-end;
    [CEReactions] attribute CSSOMString inset-block;
    [CEReactions] attribute CSSOMString inset-block-start;
